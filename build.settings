--
-- For more information on build.settings, see the Project Build Settings guide at:
-- https://docs.coronalabs.com/guide/distribution/buildSettings
--

settings =
{
	orientation =
	{
		-- Supported values for orientation:
		-- portrait, portraitUpsideDown, landscapeLeft, landscapeRight
		default = "portrait",
		supported = { "portrait", },
	},

	--
	-- Android section
	--
	android =
	{
		-- Play Console sürümlerini ayırt eden artan Android sürüm kodu.
		-- Play'deki 1 (0.0.10) sürümünden sonraki güncelleme.
		versionCode = "4",
		-- Android mağaza görünen sürümü; versionCode ile birlikte AAB'ye yazılır.
		versionName = "0.0.16",
		-- Google Play otomatik koruma koşulu için API 24 ve üzeri.
		minSdkVersion = "24",
	},

	--
	-- iOS section
	--
	iphone =
	{
		xcassets = "Images.xcassets",
		plist =
		{
			-- App Store Connect'in güncel iOS yükleme gereksinimi.
			MinimumOSVersion = "15.0",
			-- Bundle içi çalıştırılabilir adını ASCII tutarak iOS imza mühürlemesini
			-- Türkçe karakter normalizasyonundan koru; kullanıcıya görünen ad
			-- App Store Connect'teki "Yıldız Savaşı" olarak kalır.
			CFBundleDisplayName = "Yıldız Savaşı",
			UIStatusBarHidden = false,
			UILaunchStoryboardName = "LaunchScreen",
			-- Solar2D'nin eski iOS şablonundaki yer tutucu izin metinlerini
			-- Apple incelemesinde açık ve doğru metinlerle geçersiz kıl.
			NSAppleMusicUsageDescription = "Yıldız Savaşı Apple Music kitaplığınıza erişmez.",
			NSBluetoothPeripheralUsageDescription = "Yıldız Savaşı Bluetooth kullanmaz.",
			NSCalendarsUsageDescription = "Yıldız Savaşı takviminize erişmez.",
			NSCameraUsageDescription = "Yıldız Savaşı kameranızı kullanmaz.",
			NSContactsUsageDescription = "Yıldız Savaşı kişilerinize erişmez.",
			NSHomeKitUsageDescription = "Yıldız Savaşı HomeKit kullanmaz.",
			NSLocationAlwaysUsageDescription = "Yıldız Savaşı konumunuzu kullanmaz.",
			NSLocationUsageDescription = "Yıldız Savaşı konumunuzu kullanmaz.",
			NSLocationWhenInUseUsageDescription = "Yıldız Savaşı konumunuzu kullanmaz.",
			NSMicrophoneUsageDescription = "Yıldız Savaşı mikrofonu kullanmaz.",
			NSMotionUsageDescription = "Yıldız Savaşı hareket verilerini kullanmaz.",
			NSPhotoLibraryUsageDescription = "Yıldız Savaşı fotoğraf arşivinizi okumaz.",
			NSPhotoLibraryAddUsageDescription = "Yıldız Savaşı fotoğraf arşivinize erişmez.",
			NSRemindersUsageDescription = "Yıldız Savaşı anımsatıcılarınıza erişmez.",
			NSSiriUsageDescription = "Yıldız Savaşı Siri ile bütünleşmez.",
			NSSpeechRecognitionUsageDescription = "Yıldız Savaşı konuşma tanımayı kullanmaz.",
		},
	},

	--
	-- Plugins section
	--
	plugins =
	{

	},

	--
	-- Project section
	--
	excludeFiles =
	{
		-- Exclude unnecessary files for each platform
		all = { "Icon.png", "Icon-*dpi.png", "Images.xcassets", "main_original.lua", "scene-template.lua", "*.DS_Store", ".git", ".git/*", ".git/**", },
		android = { "LaunchScreen.storyboardc", },
	},
}
